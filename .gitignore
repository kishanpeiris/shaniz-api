# Real secrets — DATABASE_URL, JWT_SECRET, RECAPTCHA_SECRET_KEY, payment
# gateway keys, etc. .env.example (no real values) is fine to commit;
# this file is not. See SETUP-AND-DEPLOYMENT.md Step 2.
.env
.env.*
!.env.example

node_modules/

# Local-disk upload fallback (see src/lib/uploads.js) — only used when
# Cloudinary isn't configured; never meant to be committed either way.
uploads/*
!uploads/.gitkeep

# Editor/OS noise
.DS_Store
*.log
npm-debug.log*
