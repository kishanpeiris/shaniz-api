# Copy this file to .env and fill in real values.
# NEVER commit .env — it's already in .gitignore.

# Postgres connection string. Neon/Supabase give you this directly.
DATABASE_URL=postgres://postgres:password@localhost:5432/shaniz_dev

# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Where the React front-end is served from — used for CORS + cookie settings.
FRONTEND_ORIGIN=http://localhost:5173

# Port the API listens on.
PORT=4000

# Set to "production" on the real host — enables Secure cookies, stricter CORS.
NODE_ENV=development

# One-time seed script only (scripts/seed-superadmin.js). Never used at
# request-time, never logged, never committed.
SUPERADMIN_NAME=Site Owner
SUPERADMIN_EMAIL=owner@shaniz.lk
SUPERADMIN_PASSWORD=change-me-before-running-the-seed-script

# Payment gateways — sandbox credentials go here once you have them
# (see project-spec.md Section 4). Leave blank until then; the webhook
# routes will reject unsigned requests either way.
KOKO_MERCHANT_ID=
KOKO_API_SECRET=
INTPAY_MERCHANT_ID=
INTPAY_API_SECRET=

# PayHere (https://www.payhere.lk) — powers the "Credit / Debit Card"
# option. Unlike Koko/IntPay above, this one is a real, working
# integration, not a placeholder — and PayHere's own sandbox is free
# and instant (no merchant approval wait): sign up, go to Settings >
# Domains & Credentials, add "sandbox.payhere.lk" as an allowed domain
# during testing, and copy your Merchant ID + Merchant Secret from
# there. PAYHERE_MODE controls which of PayHere's two environments is
# used — leave it as "sandbox" until you're genuinely ready to take
# real payments.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
# Only needed for the admin panel's refund button — a separate
# credential pair from the two above, generated from PayHere's
# dashboard under Settings > Business Apps (tick the "Payment
# Retrieval API" permission). Refunds simply won't work without these,
# but checkout/payment itself doesn't need them.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# Resend — for order confirmation, shipping, invoice & booking emails.
# Leave blank in dev: emails are logged to the console instead of sent.
# Sign up at https://resend.com, verify a sending domain, then paste the
# API key here.
EMAIL_API_KEY=
EMAIL_FROM=orders@shaniz.lk

# Cloudinary — for product/service image + hover-GIF uploads. Leave all
# three blank in dev: uploads fall back to local disk (served at /uploads)
# so the feature still works without an account. Get these from your
# Cloudinary dashboard (cloudinary.com) once you're ready.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LocationIQ (https://locationiq.com) — free tier, no credit card. Powers
# two things: Admin > Branches "find on map from address", and the
# "Address line 1" autocomplete on checkout/account. Leave blank and both
# still work, falling back to OpenStreetMap's Nominatim — but that free
# public service occasionally rate-limits requests from shared hosting,
# so a free LocationIQ key is worth grabbing before launch.
GEOCODING_API_KEY=

# The API's own public URL — only needed in production, so images saved
# via the local-disk fallback resolve for site visitors (not just
# localhost). e.g. https://api.shaniz.lk. Leave blank in dev.
PUBLIC_API_URL=

# Google Gemini API key — powers the admin panel's "Generate description
# with AI" button on Products. Leave blank and that button will show a
# clear error instead of failing silently; nothing else depends on this.
# Get a FREE key (no credit card) at https://aistudio.google.com/apikey.
# This does NOT enable web search — descriptions are written only from
# what you type into the admin form.
GEMINI_API_KEY=
# Optional override if you ever need to pin a specific Gemini model
# instead of the auto-updating "latest" alias used by default.
GEMINI_MODEL=

# Fraud-detection rule thresholds — sensible defaults are built in, only
# set these if you want to tune them. See src/lib/fraud.js for what each
# one does.
FRAUD_FIRST_ORDER_THRESHOLD_LKR=
FRAUD_VELOCITY_WINDOW_MINUTES=
FRAUD_VELOCITY_MAX_ORDERS=
FRAUD_REFUND_HISTORY_THRESHOLD=

# Twilio — order/booking confirmation TEXT MESSAGES. Leave all three
# blank in dev: messages are logged to the console instead of sent, same
# as EMAIL_API_KEY above. Sign up at https://twilio.com, buy a number,
# and copy these from your Twilio console. (Any other SMS provider with
# an HTTP API works too — see the comment at the top of src/lib/sms.js.)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
