# Copy this file to .env and fill in real values.
# NEVER commit .env — it's already in .gitignore.

# Postgres connection string. Neon/Supabase give you this directly.
DATABASE_URL=postgres://postgres:password@localhost:5432/shaniz_dev

# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Where the React front-end is served from — used for CORS + cookie settings.
FRONTEND_ORIGIN=http://localhost:5173

# Port the API listens on.
PORT=4000

# Set to "production" on the real host — enables Secure cookies, stricter CORS.
NODE_ENV=development

# One-time seed script only (scripts/seed-superadmin.js). Never used at
# request-time, never logged, never committed.
SUPERADMIN_NAME=Site Owner
SUPERADMIN_EMAIL=owner@shaniz.lk
SUPERADMIN_PASSWORD=change-me-before-running-the-seed-script

# Payment gateways — sandbox credentials go here once you have them
# (see project-spec.md Section 4). Leave blank until then; the webhook
# routes will reject unsigned requests either way.
KOKO_MERCHANT_ID=
KOKO_API_SECRET=
INTPAY_MERCHANT_ID=
INTPAY_API_SECRET=
DIALOG_GENIE_MERCHANT_ID=
DIALOG_GENIE_API_SECRET=

# Resend — for order confirmation, shipping, invoice & booking emails.
# Leave blank in dev: emails are logged to the console instead of sent.
# Sign up at https://resend.com, verify a sending domain, then paste the
# API key here.
EMAIL_API_KEY=
EMAIL_FROM=orders@shaniz.lk

# Cloudinary — for product/service image + hover-GIF uploads. Leave all
# three blank in dev: uploads fall back to local disk (served at /uploads)
# so the feature still works without an account. Get these from your
# Cloudinary dashboard (cloudinary.com) once you're ready.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The API's own public URL — only needed in production, so images saved
# via the local-disk fallback resolve for site visitors (not just
# localhost). e.g. https://api.shaniz.lk. Leave blank in dev.
PUBLIC_API_URL=
